{
  "name": "trial-bi-client",
  "version": "1.4.0",
  "private": true,
  "scripts": {
    "start": "vite --host",
    "test": "vitest",
    "test:ci": "vitest run",
    "build": "pnpm type-check && pnpm build-only",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.11",
    "@heroicons/vue": "^2.0.16",
    "axios": "^1.3.4",
    "exceljs": "^4.3.0",
    "fast-sort": "^3.2.1",
    "simple-statistics": "^7.8.3",
    "vue": "^3.2.45",
    "vue-i18n": "^11.4.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.9",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.4.13",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.2.7",
    "typescript": "~5.9.3",
    "vite": "^6.4.5",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "browserslist": [
    "defaults and supports es6-module"
  ],
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@10.33.1"
}
